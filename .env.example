# GEMINI_API_KEY: Primary Google Gemini API key (configured via AI Studio Settings > Secrets).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional backup Google Gemini API keys (automatic failover when a key hits 429 rate limits).
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# Optional Groq AI API key for ultra-fast Whisper transcription & Llama fallback.
GROQ_API_KEY=""

# Optional AssemblyAI API key for high-accuracy timestamped speech transcription.
ASSEMBLYAI_API_KEY=""

# Optional GitHub OAuth credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

